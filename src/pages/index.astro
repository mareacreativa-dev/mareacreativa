---
import HeroIndex from "../components/HeroIndex.astro";
import HeroStats from "../components/HeroStats.astro";
import Layout from "../layouts/Layout.astro";
import ServicesPillars from "../components/ServicesPillars.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import TestimonialSection from "../components/TestimonialSection.astro";
import CtaSection from "../components/CtaSection.astro";
---

<Layout
  title="Marea Creativa | Tecnología e IA para Empresas"
  description="Implementamos IA, automatizamos procesos y desarrollamos software a medida para que tu empresa facture más sin depender del trabajo manual. Partner tecnológico para PYMEs en España."
  keywords="implementacion ia empresas, automatizacion procesos empresariales, agentes ia, crm automatizado, software a medida pymes, integraciones sistemas empresas, chatbot ia empresas"
  image="https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771944145/home_hero_yqmogi.png"
>
  <div id="hero">
    <HeroIndex
      title="Implementamos tecnología para que tu empresa crezca sin límites"
      subtitle="Software a medida, inteligencia artificial específica para tu negocio y automatización de procesos — para que vos te enfoques en lo que mejor hacés."
      badge="Partner Tecnológico para Empresas"
      ctaText="Agendar una cita"
    />
    <HeroStats />
    <ServicesPillars />
    <ProcessSteps />
    <TestimonialSection />
    <CtaSection />
  </div>
</Layout>
