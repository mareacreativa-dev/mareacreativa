---
import Layout from "../layouts/Layout.astro";
import AnimatedServiceCard from "../components/AnimatedServiceCard.jsx";
import CtaSection from "../components/CtaSection.astro";
import HeroService from "../components/HeroService.astro";

const services = [
  {
    title: "Web & Presencia Digital",
    description: "Sites y landing pages construidos para convertir visitas en clientes. Rápidos, profesionales, orientados a venta.",
    image: "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771930277/office_team_sdjvxo.jpg",
    variant: "image",
    imageClassName: "object-cover object-bottom",
    href: "/diseno-y-desarrollo-web",
  },
  {
    title: "Agentes IA para tu Empresa",
    description: "IA entrenada con el conocimiento de tu negocio: atiende clientes, califica leads y responde 24/7 sin intervención humana.",
    image: "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771930346/chatbots_v2_sltcgz.png",
    variant: "image",
    imageClassName: "object-cover object-bottom",
    href: "/agentes-ia",
  },
  {
    title: "Automatización de Procesos",
    description: "Conectamos tus herramientas y eliminamos el trabajo manual repetitivo con Make, n8n y automatizaciones a medida.",
    image: "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771948015/Gemini_Generated_Image_rpyoearpyoearpyo_pivghj.webp",
    variant: "image",
    imageClassName: "object-cover object-bottom",
    href: "/automatizacion-de-procesos",
  },
  {
    title: "CRM & Captación de Leads",
    description: "Sistema de ventas automatizado: captación, seguimiento y cierre. Ningún lead se enfría sin que el sistema actúe.",
    image: "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771929988/cafe_v2_nrrwj7.webp",
    variant: "image",
    imageClassName: "object-cover object-top",
    href: "/crm-captacion-leads",
  },
  {
    title: "Software a Medida",
    description: "Aplicaciones internas, dashboards y herramientas construidas específicamente para los procesos únicos de tu empresa.",
    image: "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771929812/rebranding_al9jxt.webp",
    variant: "image",
    imageClassName: "object-cover object-center",
    href: "/software-a-medida",
  },
  {
    title: "Integración de Sistemas",
    description: "WhatsApp, CRM, ERP, facturación, calendarios — todos tus sistemas conectados y sincronizados en tiempo real.",
    image: "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771930116/salon_v2_dbpsof.png",
    variant: "image",
    imageClassName: "object-cover object-center",
    href: "/integracion-sistemas",
  },
];
---

<Layout
  title="Servicios de Tecnología e IA para Empresas | Marea Creativa"
  description="IA, automatización, CRM, software a medida e integración de sistemas para empresas que quieren crecer sin depender de más personal."
  keywords="agentes ia empresas, automatizacion de procesos empresas, crm captacion leads, software a medida, integracion de sistemas, tecnologia para empresas españa"
  image="https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771948158/Gemini_Generated_Image_l9nm6ml9nm6ml9nm_qw74u9.webp"
>
  <HeroService
    badge="Tecnología para Empresas"
    title="Lo que implementamos. Lo que te cambia el negocio."
    subtitle="IA, automatización, software a medida y sistemas conectados — todo enfocado en que tu empresa facture más sin depender de más gente."
    image="https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771948158/Gemini_Generated_Image_l9nm6ml9nm6ml9nm_qw74u9.webp"
  />

  <!-- Lista de Servicios en Grid Premium-Style -->
  <section class="py-24 bg-[#fcfcfd]">
    <div class="container mx-auto px-4 md:px-8 max-w-[1050px]">
      <div class="text-left mb-16 max-w-3xl">
        <h2
          class="text-4xl md:text-5xl font-bold mb-6 tracking-tight text-gray-900"
        >
          Tecnología que resuelve. <span class="text-gray-500">Resultados desde el primer mes.</span>
        </h2>
        <p class="text-xl text-gray-500 font-medium">
          Cada servicio está diseñado para resolver un problema concreto en tu empresa y generar retorno medible.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8"
      >
        {
          services.map((service, index) => (
            <AnimatedServiceCard
              client:visible
              title={service.title}
              description={service.description}
              image={service.image}
              variant={service.variant}
              imageClassName={service.imageClassName}
              index={index}
              className="aspect-[3/4] h-auto w-full max-w-[320px] mx-auto"
              href={service.href}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proceso de Trabajo / Metodología -->
  <section class="max-w-7xl mx-auto px-4 md:px-8 py-20 md:py-32">
    <div class="text-center mb-16 md:mb-24 max-w-3xl mx-auto">
      <div
        class="inline-flex items-center space-x-2 bg-blue-50 text-blue-700 rounded-full px-4 py-1.5 mb-6 font-semibold text-xs tracking-wider uppercase border border-blue-100 w-fit"
      >
        <span>Metodología Marea</span>
      </div>
      <h2
        class="text-4xl md:text-5xl font-bold mb-6 tracking-tight text-gray-900"
      >
        Cómo trabajamos
      </h2>
      <p class="text-gray-500 text-xl font-medium leading-relaxed">
        Un proceso estructurado para implementar tecnología sin fricciones, sin disrupciones para tu equipo y con impacto real desde el primer sprint.
      </p>
    </div>

    <!-- Etapas (Cascading Grid layout para dar un ritmo de lectura a la vista) -->
    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-8 px-2 md:px-0 relative z-10 lg:pb-32"
    >
      <!-- Paso 1 -->
      <div
        class="p-10 md:p-12 rounded-[32px] md:rounded-[48px] bg-white border border-gray-100 shadow-sm hover:shadow-xl transition-shadow flex flex-col items-center md:items-start text-center md:text-left h-full"
      >
        <span
          class="text-blue-100 text-7xl md:text-8xl font-black mb-4 block leading-none tracking-tighter self-center md:self-start"
          >01</span
        >
        <h3 class="text-2xl font-bold text-gray-900 mb-4">
          Auditoría <br class="hidden lg:block" />y Diagnóstico
        </h3>
        <p class="text-gray-500 font-medium leading-relaxed text-lg">
          Analizamos tus cuellos de botella actuales, cómo estás perdiendo
          tiempo en burocracia o dónde exactamente se te escapan posibles
          clientes online mes a mes.
        </p>
      </div>

      <!-- Paso 2 -->
      <div
        class="p-10 md:p-12 rounded-[32px] md:rounded-[48px] bg-white border border-gray-100 shadow-sm hover:shadow-xl transition-shadow flex flex-col items-center md:items-start text-center md:text-left lg:mt-16 h-full"
      >
        <span
          class="text-blue-100 text-7xl md:text-8xl font-black mb-4 block leading-none tracking-tighter self-center md:self-start"
          >02</span
        >
        <h3 class="text-2xl font-bold text-gray-900 mb-4">
          Ingeniería <br class="hidden lg:block" />Estratégica
        </h3>
        <p class="text-gray-500 font-medium leading-relaxed text-lg">
          Diseñamos piezas digitales precisas adaptadas a tus servicios y
          seleccionamos exactamente la tecnología y flujos sistémicos que
          generarán rentabilidad para ti.
        </p>
      </div>

      <!-- Paso 3 -->
      <div
        class="p-10 md:p-12 rounded-[32px] md:rounded-[48px] bg-white border border-gray-100 shadow-sm hover:shadow-xl transition-shadow flex flex-col items-center md:items-start text-center md:text-left lg:mt-32 h-full"
      >
        <span
          class="text-blue-100 text-7xl md:text-8xl font-black mb-4 block leading-none tracking-tighter self-center md:self-start"
          >03</span
        >
        <h3 class="text-2xl font-bold text-gray-900 mb-4">
          Desarrollo <br class="hidden lg:block" />e Implementación
        </h3>
        <p class="text-gray-500 font-medium leading-relaxed text-lg">
          Ejecutamos con calidad premium y extrema confidencialidad mientras tú
          y tu equipo siguen dirigiendo y empujando el negocio físico sin
          distracciones que pesen.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA para cerrar el embudo de ventas -->
  <CtaSection />
</Layout>
