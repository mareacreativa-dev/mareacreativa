---
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu";
import CookieBanner from "../components/CookieBanner.astro";
import ChatWidget from "../components/ChatWidget";
import "../styles/global.css";
const {
  title = "Marea Creativa | Software, IA y Automatización para Empresas",
  description = "Implementamos tecnología para que tu empresa crezca: software personalizado, inteligencia artificial específica para tu negocio y automatización de procesos. Enfócate en tu producto, nosotros en la tecnología.",
  keywords = "software a medida empresas, inteligencia artificial negocios, automatizacion procesos empresariales, agentes ia, software personalizado pymes, implementacion tecnologia empresas",
  image = "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771944145/home_hero_yqmogi.png",
} = Astro.props;
import { ClientRouter } from "astro:transitions";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="robots" content="index, follow" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="https://res.cloudinary.com/dgkdq8kzk/image/upload/v1756154116/logo_m_blanco_y3leyc.svg"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Marea Creativa" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Schema Markup para Google -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://mareacreativa.com/#website",
            url: "https://mareacreativa.com",
            name: "Marea Creativa",
            description: "Software personalizado, IA y automatización de procesos para empresas",
            inLanguage: "es",
          },
          {
            "@type": "ProfessionalService",
            "@id": "https://mareacreativa.com/#organization",
            name: "Marea Creativa",
            url: "https://mareacreativa.com",
            logo: "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1756154116/logo_m_blanco_y3leyc.svg",
            description: "Implementamos tecnología para empresas: software a medida, inteligencia artificial específica para cada negocio y automatización de procesos.",
            areaServed: "ES",
            serviceType: ["Software a medida", "Inteligencia Artificial", "Automatización de procesos"],
            sameAs: ["https://www.instagram.com/marea.creativa"],
          },
        ],
      })}
    ></script>
  </head>
  <body>
    <header>
      <Menu client:load transition:persist="menu" />
    </header>
    <main class="flex-grow bg-tertiary">
      <slot />
    </main>
    <Footer transition:persist="footer" />
    <CookieBanner transition:persist="cookie-banner" />
    <ChatWidget client:load transition:persist="chat-widget" />
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        font-family: system-ui, Roboto;
      }
    </style>
  </body>
</html>
