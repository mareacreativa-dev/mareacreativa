---
export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaLink?: string;
  badge?: string;
}

const {
  title,
  subtitle,
  ctaText = "Habla con nosotros",
  ctaLink = "/contacto",
  badge = "Tecnología e IA para Empresas",
} = Astro.props;

// Highlighted last portion of the headline
const highlightedTitle = "crezca sin límites";
const mainTitle = title.replace(highlightedTitle, "").trim();

const imgBg =
  "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771944530/home_hero_1_t0rla7.webp";
---

<section
  class="relative w-full min-h-[88vh] flex items-center justify-center overflow-hidden"
  style="background-color: #070a1a;"
>
  <!-- Background image — diffuse -->
  <div class="absolute inset-0 z-0">
    <img
      src={imgBg}
      alt=""
      class="w-full h-full object-cover object-center scale-110"
      style="opacity: 0.14; filter: blur(6px);"
    />
    <!-- Dark overlay + gradient fade to bottom -->
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse at 50% -10%, rgba(14,68,249,0.22) 0%, transparent 55%), linear-gradient(to bottom, rgba(7,10,26,0.2) 0%, rgba(7,10,26,0.7) 60%, #070a1a 100%);"
    ></div>
  </div>

  <!-- Ambient blue glow top-center -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 pointer-events-none"
    style="width: 700px; height: 320px; background: radial-gradient(ellipse at top, rgba(14,68,249,0.20), transparent 65%); filter: blur(48px);"
  ></div>

  <!-- Content -->
  <div class="relative z-10 w-full max-w-4xl mx-auto px-6 py-28 text-center">

    <!-- Badge -->
    {
      badge && (
        <div
          class="inline-flex items-center gap-2.5 rounded-full px-5 py-2 mb-10 text-xs font-bold tracking-widest uppercase fade-in-up"
          style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14); color: rgba(255,255,255,0.85); backdrop-filter: blur(8px); animation-delay: 0ms;"
        >
          <span
            class="w-1.5 h-1.5 rounded-full flex-shrink-0"
            style="background: #0e44f9;"
          ></span>
          <span>{badge}</span>
        </div>
      )
    }

    <!-- Headline -->
    <h1
      class="font-extrabold text-white leading-[1.06] tracking-tight mb-7 fade-in-up"
      style="font-size: clamp(2.6rem, 7vw, 4.5rem); letter-spacing: -0.03em; animation-delay: 80ms;"
    >
      {mainTitle}<br />
      <span style="color: #0e44f9;">{highlightedTitle}</span>
    </h1>

    <!-- Subtitle -->
    <p
      class="mx-auto leading-relaxed mb-10 fade-in-up"
      style="color: rgba(255,255,255,0.55); font-size: clamp(1rem, 2vw, 1.125rem); max-width: 520px; animation-delay: 160ms;"
    >
      {subtitle}
    </p>

    <!-- CTAs -->
    <div
      class="flex flex-col sm:flex-row gap-4 justify-center fade-in-up"
      style="animation-delay: 240ms;"
    >
      <a
        href={ctaLink}
        class="inline-flex items-center justify-center gap-2 text-white font-semibold text-base px-7 py-3.5 rounded-full transition-all duration-200 active:scale-95"
        style="background: #0e44f9; box-shadow: 0 4px 24px rgba(14,68,249,0.35);"
        onmouseover="this.style.background='#2a5bfa'"
        onmouseout="this.style.background='#0e44f9'"
      >
        {ctaText}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>
      <a
        href="/servicios"
        class="inline-flex items-center justify-center gap-2 text-white font-semibold text-base px-7 py-3.5 rounded-full transition-all duration-200 active:scale-95"
        style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); backdrop-filter: blur(8px);"
        onmouseover="this.style.background='rgba(255,255,255,0.15)'"
        onmouseout="this.style.background='rgba(255,255,255,0.08)'"
      >
        Ver servicios
      </a>
    </div>
  </div>
</section>

<style>
  .fade-in-up {
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    transform: translateY(28px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
