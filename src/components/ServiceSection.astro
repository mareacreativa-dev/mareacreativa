---
import AnimatedServiceCard from "./AnimatedServiceCard.jsx";

const services = [
  {
    title: "Web & Presencia Digital",
    description:
      "Sites y landing pages optimizados para convertir visitas en clientes. Rápidos, profesionales y construidos para vender.",
    image:
      "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771930277/office_team_sdjvxo.jpg",
    variant: "image",
    imageClassName: "object-cover object-bottom",
    href: "/diseno-y-desarrollo-web",
  },
  {
    title: "Agentes IA para tu Empresa",
    description:
      "IA entrenada con el conocimiento de tu negocio que atiende clientes, califica leads y responde consultas sin intervención humana.",
    image:
      "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771930346/chatbots_v2_sltcgz.png",
    variant: "image",
    imageClassName: "object-cover object-bottom",
    href: "/agentes-ia",
  },
  {
    title: "Automatización de Procesos",
    description:
      "Conectamos tus herramientas y eliminamos el trabajo manual repetitivo con Make, n8n y automatizaciones a medida.",
    image:
      "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771948015/Gemini_Generated_Image_rpyoearpyoearpyo_pivghj.webp",
    variant: "image",
    imageClassName: "object-cover object-bottom",
    href: "/automatizacion-de-procesos",
  },
  {
    title: "CRM & Captación de Leads",
    description:
      "Sistema de ventas automatizado: captación, seguimiento y cierre. Ningún lead se enfría sin que el sistema actúe.",
    image:
      "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771929988/cafe_v2_nrrwj7.webp",
    variant: "image",
    imageClassName: "object-cover object-top",
    href: "/crm-captacion-leads",
  },
  {
    title: "Software a Medida",
    description:
      "Aplicaciones internas, dashboards y herramientas construidas específicamente para los procesos de tu empresa.",
    image:
      "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771929812/rebranding_al9jxt.webp",
    variant: "image",
    imageClassName: "object-cover object-center",
    href: "/software-a-medida",
  },
  {
    title: "Integración de Sistemas",
    description:
      "WhatsApp, CRM, ERP, facturación, calendarios — todos tus sistemas conectados y sincronizados en tiempo real.",
    image:
      "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1771930116/salon_v2_dbpsof.png",
    variant: "image",
    imageClassName: "object-cover object-center",
    href: "/integracion-sistemas",
  },
];
---

<section class="py-24 bg-[#fcfcfd]">
  <div class="container mx-auto px-4 md:px-8 max-w-[1050px]">
    <div class="text-left mb-16 max-w-3xl">
      <h2
        class="text-4xl md:text-5xl font-bold mb-6 tracking-tight text-gray-900"
      >
        Lo que implementamos. <span class="text-gray-500"
          >Resultados desde el primer mes.</span
        >
      </h2>
    </div>

    {/* Modern grid with mixed image and icon cards */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        services.map((service, index) => {
          return (
            <AnimatedServiceCard
              client:visible
              title={service.title}
              description={service.description}
              image={service.image}
              variant={service.variant}
              imageClassName={service.imageClassName}
              index={index}
              className="aspect-[3/4] h-auto w-full max-w-[320px] mx-auto"
              href={service.href}
            />
          );
        })
      }
    </div>
  </div>
</section>
