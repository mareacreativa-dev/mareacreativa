---
const cases = [
  {
    company: "Food Pack",
    sector: "Alimentación",
    image:
      "https://res.cloudinary.com/dhoxoi8ob/image/upload/v1741016313/foodpack_kcjztp.jpg",
    logo: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>`,
    quote:
      "Nos ayudaron a digitalizar todo el proceso de ventas y pedidos. Ahora gestionamos clientes en varios países sin sumar personal.",
    author: "Equipo Food Pack",
    role: "Dirección",
    stats: [
      { num: "+3x", label: "mercados alcanzados" },
      { num: "-65%", label: "gestión manual" },
    ],
  },
  {
    company: "The Cookie World",
    sector: "E-commerce",
    image:
      "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1782226092/the_cookie_gmfhk9.png",
    logo: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/><path d="M8.5 8.5v.01"/><path d="M16 15.5v.01"/><path d="M12 12v.01"/><path d="M11 17v.01"/><path d="M7 14v.01"/></svg>`,
    quote:
      "Diseñaron la web y todo el sistema de e-commerce: gestión de pedidos, stock en tiempo real y experiencia de compra impecable. Lanzamos y vendimos desde el primer día.",
    author: "Equipo The Cookie World",
    role: "Dirección",
    href: "https://thecookieworld.com/",
    stats: [
      { num: "100%", label: "pedidos online" },
      { num: "Día 1", label: "primeras ventas" },
    ],
  },
  {
    company: "Spanish Mode On",
    sector: "Turismo",
    image:
      "https://res.cloudinary.com/dgkdq8kzk/image/upload/v1782227968/Disen%CC%83o_sin_ti%CC%81tulo_iqm3pf.png",
    logo: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
    quote:
      "Crearon el sitio web desde cero con un diseño que transmite la esencia del turismo local. Desde que lanzamos, las consultas no paran de llegar.",
    author: "Equipo Spanish Mode On",
    role: "Dirección",
    href: "https://www.spanishmodeon.com/",
    stats: [
      { num: "+2x", label: "consultas recibidas" },
      { num: "100%", label: "presencia digital" },
    ],
  },
];
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-4 md:px-8 max-w-6xl">

    <!-- Header -->
    <div class="text-center mb-14 max-w-2xl mx-auto">
      <div
        class="inline-flex items-center space-x-2 bg-blue-50 text-blue-700 rounded-full px-4 py-1.5 mb-6 font-semibold text-xs tracking-wider uppercase border border-blue-100 w-fit"
      >
        <span>Lo que dicen nuestros clientes</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
        Resultados reales. Empresas reales.
      </h2>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        cases.map((c) => (
          <div class="flex flex-col bg-[#f8f9fb] border border-gray-100 rounded-[28px] overflow-hidden hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 group">

            <!-- Image -->
            <div class="relative h-44 overflow-hidden">
              <img
                src={c.image}
                alt={c.company}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
              <!-- Dark gradient overlay for legibility -->
              <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.45) 100%);"></div>

              <!-- Sector badge on image -->
              <span class="absolute top-3 right-3 text-xs font-semibold text-white px-3 py-1 rounded-full" style="background: rgba(0,0,0,0.35); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.15);">
                {c.sector}
              </span>
            </div>

            <!-- Card body -->
            <div class="flex flex-col flex-1 p-7">

              <!-- Logo + company name -->
              <div class="flex items-center gap-3 mb-5">
                <div
                  class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-blue-600"
                  style="background: rgba(14,68,249,0.08); width: 36px; height: 36px;"
                >
                  <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <Fragment set:html={c.logo} />
                  </svg>
                </div>
                <span class="font-bold text-gray-900 text-base" style="font-family: 'Space Grotesk', sans-serif;">
                  {c.company}
                </span>
              </div>

              <!-- Quote -->
              <blockquote class="text-gray-600 text-sm leading-relaxed mb-5 flex-1">
                "{c.quote}"
              </blockquote>

              <!-- Author -->
              <p class="text-sm mb-5">
                <span class="font-semibold text-gray-800">{c.author}</span>
                <span class="text-gray-400"> · {c.role}</span>
              </p>

              <!-- Stats -->
              <div class="flex gap-6 pt-4 border-t border-gray-200">
                {c.stats.map((s) => (
                  <div>
                    <div
                      class="text-2xl font-bold"
                      style="font-family:'Space Grotesk',sans-serif; color: #0E44F9;"
                    >
                      {s.num}
                    </div>
                    <div class="text-xs text-gray-400 mt-0.5">{s.label}</div>
                  </div>
                ))}
              </div>

            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
