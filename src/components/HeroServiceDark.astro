---
export interface Props {
  title: string;
  subtitle: string;
  image: string;
  badge?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  title,
  subtitle,
  image,
  badge,
  ctaText = "Solicitar presupuesto",
  ctaLink = "/contacto",
} = Astro.props;
---

<section
  class="relative w-full min-h-[60vh] flex items-center justify-center overflow-hidden"
  style="background-color: #070a1a;"
>
  <!-- Background image with dark overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt=""
      class="w-full h-full object-cover object-center"
      style="opacity: 0.22; filter: blur(2px); transform: scale(1.05);"
    />
    <!-- Gradient overlays -->
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse at 50% -10%, rgba(14,68,249,0.20) 0%, transparent 55%), linear-gradient(to bottom, rgba(7,10,26,0.25) 0%, rgba(7,10,26,0.65) 55%, #070a1a 100%);"
    ></div>
  </div>

  <!-- Ambient blue glow top-center -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 pointer-events-none"
    style="width: 600px; height: 260px; background: radial-gradient(ellipse at top, rgba(14,68,249,0.18), transparent 65%); filter: blur(48px);"
  ></div>

  <!-- Content -->
  <div class="relative z-10 w-full max-w-3xl mx-auto px-6 py-24 text-center">

    <!-- Badge -->
    {
      badge && (
        <div
          class="inline-flex items-center gap-2.5 rounded-full px-5 py-2 mb-8 text-xs font-bold tracking-widest uppercase fade-in-up"
          style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14); color: rgba(255,255,255,0.85); backdrop-filter: blur(8px);"
        >
          <span
            class="w-1.5 h-1.5 rounded-full flex-shrink-0"
            style="background: #0e44f9;"
          ></span>
          <span>{badge}</span>
        </div>
      )
    }

    <!-- Headline -->
    <h1
      class="font-extrabold text-white leading-[1.06] tracking-tight mb-6 fade-in-up"
      style="font-size: clamp(2.2rem, 5.5vw, 3.5rem); letter-spacing: -0.03em; animation-delay: 80ms;"
    >
      {title}
    </h1>

    <!-- Subtitle -->
    <p
      class="mx-auto leading-relaxed mb-10 fade-in-up"
      style="color: rgba(255,255,255,0.55); font-size: clamp(0.95rem, 1.8vw, 1.1rem); max-width: 500px; animation-delay: 160ms;"
    >
      {subtitle}
    </p>

    <!-- CTA -->
    <div class="fade-in-up" style="animation-delay: 240ms;">
      <a
        href={ctaLink}
        class="inline-flex items-center justify-center gap-2 text-white font-semibold text-base px-7 py-3.5 rounded-full transition-all duration-200 active:scale-95"
        style="background: #0e44f9; box-shadow: 0 4px 24px rgba(14,68,249,0.35);"
        onmouseover="this.style.background='#2a5bfa'"
        onmouseout="this.style.background='#0e44f9'"
      >
        {ctaText}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .fade-in-up {
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    transform: translateY(28px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
